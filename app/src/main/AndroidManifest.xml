<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Installation de la mise à jour téléchargée depuis GitHub (Paramètres > Mises à jour). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+ : mise à jour de Streamia par elle-même sans fenêtre de confirmation. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- Android 14+ : Streamia reste propriétaire de ses mises à jour (setRequestUpdateOwnership). -->
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />

    <!-- Lecture qui continue écran verrouillé ou appli quittée (mobile) : service de premier plan « média ». -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android TV et téléphones/tablettes : l'interface (télécommande ou tactile) est choisie au lancement. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <supports-screens
        android:largeScreens="true"
        android:xlargeScreens="true" />

    <application
        android:allowBackup="false"
        android:largeHeap="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Streamia.Starting"
        android:usesCleartextTraffic="true">

        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Cartes « Continuer à regarder » de l'accueil Google TV (WatchNextPublisher). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="streamia" android:host="resume" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.PlaybackForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Résultat de l'installation de mise à jour (session PackageInstaller, voir UpdateInstaller). -->
        <receiver
            android:name=".data.UpdateInstallReceiver"
            android:exported="false" />
    </application>

</manifest>
